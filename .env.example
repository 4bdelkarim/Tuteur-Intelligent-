[TEMPLATE]
# Ce fichier documente la configuration. Les valeurs ci-dessous sont les
# valeurs par défaut du code (voir src/rag_tutor/core/).
# Copier en `.env` si un jour le code lit ces variables (actuellement : aucune
# variable n'est lue depuis l'environnement — tout est défini en dur dans core/).

# Ollama server
OLLAMA_HOST=http://127.0.0.1:11434

# Mode hors-ligne : le modèle bge-reranker est déjà en cache local
HF_HUB_OFFLINE=1

# Pas de GPU CUDA → évite le warning PyTorch au lancement
CUDA_VISIBLE_DEVICES=

# ChromaDB persistence (dossier réel : dbfig_pc, hardcodé dans core/vector_store.py)
CHROMA_DB_PATH=dbfig_pc

# Models
GEN_MODEL=qwen2.5:14b
JUDGE_MODEL=qwen3:8b
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
